{
  "name": "orggraph",
  "version": "1.0.0",
  "description": "OrgGraph Visualization \u2014 dependency-free single-file app (index.html)",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "verify": "node verify.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node build.js --no-bump && node remap-coverage.js",
    "transform": "node helpers/transform.js",
    "prepare": "git config core.hooksPath .githooks",
    "e2e": "playwright test --project=smoke",
    "e2e:acceptance": "playwright test --project=acceptance"
  },
  "devDependencies": {
    "@babel/generator": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^3.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fake-indexeddb": "^6.0.1",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
