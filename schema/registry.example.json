{
  "$comment": "Illustrative example of a registry conforming to registry.schema.json (PRD E14). The real registry.json is curated via phase A + gate (PRD FR-6.1a) and grows from actual source analyses; nothing in this file is an implementation mandate.",
  "version": "2026-07-02.1",
  "nodeTypes": {
    "Person": {
      "labelProp": "label",
      "identifiers": ["id", "props.email"],
      "leafProp": "props.isBasis",
      "pseudonymize": { "pool": "names" },
      "props": {
        "email": { "type": "string" },
        "pensum": { "type": "number" },
        "isBasis": { "type": "boolean" }
      }
    },
    "OE": {
      "pseudonymize": { "pool": "orgUnits", "byLevel": true }
    },
    "Rolle": {},
    "Firma": {}
  },
  "edgeTypes": {
    "unterstellt": { "from": "OE", "to": "OE" },
    "mitgliedIn": { "from": "Person", "to": "OE" },
    "berichtetAn": { "from": "Person", "to": "Person" },
    "arbeitetBei": { "from": "Person", "to": "Firma" },
    "hatRolle": {
      "from": "Person",
      "to": "Rolle",
      "identityProps": ["kontext"],
      "props": {
        "kontext": { "ref": "Firma", "implies": "arbeitetBei" }
      }
    }
  }
}
