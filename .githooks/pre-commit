#!/bin/sh
# Versioning + build hook.
#
# Versioning is owned by the AI-Toolbox bumper, invoked through the managed
# `toolbox-bump` shim line below: it bumps APP_VERSION (the single source of
# truth) in index.template.html — MINOR+BUILD on commit; the per-edit
# PostToolUse hook bumps BUILD on every edit. build.js is independent of
# versioning: it just reads the current APP_VERSION from the template and stamps
# the single-file deliverable index.html. Bump first, then build, so index.html
# always carries the freshly bumped version.
#
# `toolbox-bump` is the AI-Toolbox launcher on PATH (~/.local/bin, created by
# `toolbox install --what versioning-hooks`); calling it by name keeps this
# committed hook portable. The shim line is managed by the toolbox (re-install
# refreshes it in place) — keep it ahead of the build step.
set -e
toolbox-bump pre-commit   # ai-toolbox:versioning-hooks (managed - do not edit)
node build.js
git add index.template.html index.html
